<link rel="stylesheet" href={{trainingStyle}}>
<script src="https://player.vimeo.com/api/player.js" defer></script>

<div class="wrapper">

    <div class="nav-container">
        <nav>
            {{!-- Logo --}}
            <div class="logo_container">
                <a href="/">
                    <img src="/images/main-logo.png" alt="NAGINATTAZ logo in black."
                        class="navbar10_logo icon-height-xlarge" />
                </a>
            </div>
            {{!-- Menu --}}
            <div class="nav_links">
                <a href="/">Inicio</a>
                <a href="/entrenamiento">Clases</a>
                <a href="/nagidatta">Nagidatta</a>
            </div>
            {{!-- Botonera --}}
            <div class="botonera">
                <div class="profile_pic">
                    <img src={{userData.profileImg}} alt="Profile picture">
                </div>
                <button type="button">Logout</button>
            </div>
            <div class="nav__hamburger">
                <button type="button" class="hamburger">
                    <span class="hamburger__line"></span>
                    <span class="hamburger__line"></span>
                    <span class="hamburger__line"></span>
                </button>
            </div>
        </nav>
    </div>

    <aside>
        <ul>
            <li onclick="toggleSection(this)">Todas las clases <span class="arrow"></span></li>
            <li onclick="toggleSection(this)">Clases individuales <span class="arrow"></span></li>
            <li onclick="toggleSection(this)">Programas <span class="arrow"></span></li>
            <li onclick="toggleSection(this)">Estilos <span class="arrow"></span></li>
            <li onclick="toggleSection(this)">Playlist <span class="arrow"></span></li>
            <li onclick="toggleSection(this)">Calendario <span class="arrow"></span></li>
            <li onclick="toggleSection(this)">Comunidad <span class="arrow"></span></li>
        </ul>
    </aside>

    <section>
        <h1>Bienvenido {{userData.name}}</h1>
        <article>
            <div class="grid-auto-fill">
                {{#each courses}}
                <div class="course-container">
                    <div class="course-card">
                        <h3>{{this.course_name}}</h3>
                        <p>{{this.course_level}}</p>
                        <p>${{this.course_price}}</p>
                        <img src={{this.course_image}} alt="">
                    </div>
                </div>
                {{/each}}
                {{#each courses}}
                <div class="course-container">
                    <div class="course-card">
                        <h3>{{this.course_name}}</h3>
                        <p>{{this.course_level}}</p>
                        <p>${{this.course_price}}</p>
                        <img src={{this.course_image}} alt="">
                    </div>
                </div>
                {{/each}}
                {{#each courses}}
                <div class="course-container">
                    <div class="course-card">
                        <h3>{{this.course_name}}</h3>
                        <p>{{this.course_level}}</p>
                        <p>${{this.course_price}}</p>
                        <img src={{this.course_image}} alt="">
                    </div>
                </div>
                {{/each}}
                {{#each courses}}
                <div class="course-container">
                    <div class="course-card">
                        <h3>{{this.course_name}}</h3>
                        <p>{{this.course_level}}</p>
                        <p>${{this.course_price}}</p>
                        <img src={{this.course_image}} alt="">
                    </div>
                </div>
                {{/each}}
            </div>
        </article>
    </section>
</div>

<script>
    function toggleSection(element) {
        const section = document.querySelector('section');
        if (section.style.display === 'none' || section.style.display === '') {
            section.style.display = 'block';
        } else {
            section.style.display = 'none';
        }

        // Toggle the active class on the clicked li
        element.classList.toggle('active');
    }

    function toggleHamburgerMenu() {
        const navLinks = document.querySelector('.nav_links');
        const botonera = document.querySelector('.botonera');

        if (navLinks.style.display === 'none' || navLinks.style.display === '') {
            navLinks.style.display = 'flex';
            botonera.style.display = 'flex';
        } else {
            navLinks.style.display = 'none';
            botonera.style.display = 'none';
        }
    }

    document.querySelector('.hamburger').addEventListener('click', toggleHamburgerMenu);
</script>
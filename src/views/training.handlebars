<link rel="stylesheet" href={{trainingStyle}}>
<script src="https://player.vimeo.com/api/player.js" defer></script>

<div class="wrapper">

    <div class="nav-container">
        <nav>
            {{!-- Logo --}}
            <div class="logo_container">
                <a href="/">
                    <img src="/images/main-logo.png" alt="NAGINATTAZ logo in black."
                        class="navbar10_logo icon-height-xlarge" />
                </a>
            </div>
            {{!-- Menu --}}
            <div class="nav_links">
                <a href="/">Inicio</a>
                <a href="/entrenamiento" class="active">Clases</a>
                <a href="/nagidatta">Nagidatta</a>
            </div>
            {{!-- Botonera --}}
            {{>profile}}
            {{!-- <div class="botonera">
                <div class="profile_pic">
                    <img src={{userData.profileImg}} alt="Profile picture">
                </div>
                <button type="button">Logout</button>
            </div> --}}
            <div class="nav__hamburger">
                <button type="button" class="hamburger">
                    <span class="hamburger__line"></span>
                    <span class="hamburger__line"></span>
                    <span class="hamburger__line"></span>
                </button>
            </div>
        </nav>
    </div>

    <aside>
        <ul>
            <a href="/entrenamiento/todas-las-clases">
                <li>Todas las clases <span class="arrow"></span></li>
            </a>
            <a href="/entrenamiento/clases-individuales">
                <li>Clases individuales <span class="arrow"></span></li>
            </a>
            <a href="/entrenamiento/programas">
                <li>Programas <span class="arrow"></span></li>
            </a>
            <a href="/entrenamiento/estilos">
                <li>Estilos <span class="arrow"></span></li>
            </a>
            <a href="/entrenamiento/playlists">
                <li>Playlist <span class="arrow"></span></li>
            </a>
            <a href="/entrenamiento/calendario">
                <li>Calendario <span class="arrow"></span></li>
            </a>
            <a href="/entrenamiento/comunidad">
                <li>Comunidad <span class="arrow"></span></li>
            </a>
        </ul>
    </aside>

    <section id="js-allClasses" style="display: block;">
        <h1>Bienvenido {{userData.name}}</h1>
        <article>
            <div class="grid-auto-fill">


                {{!-- HAY QUE AGREGAR UNA EVALUACIÓN PARA MOSTRAR UN BOTÓN QUE MANDE AL STORE
                SI NO HAY CURSOS COMPRADOS--}}

                {{#each courses}}
                <div class="course-container">
                    {{!-- EVALUA SI SON CLASES INDIVIDUALES --}}
                    {{#if this.class_name}}
                    <a href="/clases/{{this.id}}">
                        <div class="course-card">
                            <h3>{{this.class_name}}</h3>
                            <p>{{this.class_level}}</p>
                            <img src={{this.class_image}} alt="">
                        </div>
                    </a>
                    {{!-- EVALUA SI SON PROGRAMAS --}}
                    {{else}}
                    {{!-- HAY QUE AGREGAR UNA EVALUACION, SI ES PREMIUM MUESTRA EL PROGRAMA CON EL LINK
                    AL MISMO, SI NO MUESTRA LA IMAGEN CON DISTINTIVO DE PREMIUM 
                    O UN BOTON Y EL LINK MANDA A SUSCRIPCION --}}
                        <a href="/programas/clases/{{this.id}}">
                            <div class="course-card">
                                <h3>{{this.program_name}}</h3>
                                <p>{{this.program_level}}</p>
                                <img src={{this.program_image}} alt="">
                            </div>
                        </a>
                       
                    {{/if}}
                </div>
                {{/each}}
            </div>
        </article>
    </section>
</div>

<script>
    function toggleSection(element) {
        const section = document.getElementById('js-allClasses');
        if (section.style.display === 'none' || section.style.display === '') {
            section.style.display = 'block';
        } else {
            section.style.display = 'none';
        }

        // Toggle the active class on the clicked li
        element.classList.toggle('active');
    }

    function toggleHamburgerMenu() {
        const navLinks = document.querySelector('.nav_links');
        const botonera = document.querySelector('.botonera');

        if (navLinks.style.display === 'none' || navLinks.style.display === '') {
            navLinks.style.display = 'flex';
            botonera.style.display = 'flex';
        } else {
            navLinks.style.display = 'none';
            botonera.style.display = 'none';
        }
    }

    document.querySelector('.hamburger').addEventListener('click', toggleHamburgerMenu);
</script>
<link rel="stylesheet" href={{trainingStyle}}>
<script src="https://player.vimeo.com/api/player.js" defer></script>

<div class="wrapper">
    {{>trainingNav}}
    <aside>
        <ul>
            <li><a href="/entrenamiento/todas-las-clases">Todas las clases</a></li>
            <li><a href="/entrenamiento/clases-individuales">Clases individuales</a></li>
            <li><a href="/entrenamiento/programas">Programas</a></li>
            <li><a href="/entrenamiento/estilos">Estilos</a></li>
            <li><a href="/entrenamiento/playlists">Playlist</a></li>
            <li><a href="/entrenamiento/calendario">Calendario</a></li>
            <li><a href="/entrenamiento/comunidad">Comunidad</a></li>
        </ul>
    </aside>

    <section id="js-allClasses" style="display: block;">
        <header>
            <h1>Bienvenido {{userData.name}}</h1>
        </header>
        <article>
            <div class="grid-auto-fill">
                {{#if courses.length}}
                {{#each courses}}
                <a href="/clases/{{this.id}}" class="course-link">
                    <div class="course-card">
                        <div class="course-image">
                            <img src="{{#if this.class_image}}{{this.class_image}}{{else}}{{this.program_image}}{{/if}}"
                                alt="Imagen del curso">
                        </div>
                        <div class="course-info">
                            <h3 class="course-title">
                                {{#if this.class_name}}{{this.class_name}}{{else}}{{this.program_name}}{{/if}}
                            </h3>
                            <p class="course-level">{{this.class_level}}</p>
                            <p>{{#each this.teacherNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
                        </div>
                    </div>
                </a>
                {{/each}}
                {{else}}
                <div class="no-courses">
                    <p style="color: white;">No hay cursos disponibles en este momento.</p>
                    <a href="/store" class="store-link">Visita nuestra tienda</a>
                </div>
                {{/if}}
            </div>
        </article>
    </section>
</div>

<script>
    function toggleSection(element) {
        const section = document.getElementById('js-allClasses');
        if (section.style.display === 'none' || section.style.display === '') {
            section.style.display = 'block';
        } else {
            section.style.display = 'none';
        }

        // Toggle the active class on the clicked li
        element.classList.toggle('active');
    }

    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".course-price").forEach(el => {
            let price = el.getAttribute("data-price");
            if (price !== null && price !== "") {
                let formattedPrice = Number(price).toLocaleString("es-ES", { minimumFractionDigits: 0 });
                console.log(`Price: ${price}, formatted: ${formattedPrice}`);
                el.textContent = `$${formattedPrice}`;
            } else {
                el.textContent = "$0";
            }
        });
    });
</script>
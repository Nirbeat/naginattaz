                            <br>
                        </div>
                        <div style="padding-right: 20px;">

                            <p> También podes agregar tus propios eventos y tareas:</p>
                            <form id="eventForm">
                                <label for="eventTitle">Título del Evento:</label>
                                <input type="text" id="eventTitle" name="eventTitle" required><br><br>

                                <label for="eventDate">Fecha:</label>
                                <input type="date" id="eventDate" name="eventDate" required><br><br>

                                <label for="eventStartTime">Hora de comienzo (HH:MM):</label>
                                <input type="time" id="eventStartTime" name="eventStartTime" required><br><br>

                                <label for="eventEndTime">Hora de finalización (HH:MM):</label>
                                <input type="time" id="eventEndTime" name="eventEndTime" required><br><br>

                                <label for="eventDetails">Detalles:</label>
                                <textarea id="eventDetails" name="eventDetails" required></textarea><br><br>

                                <label for="eventLocation">Ubicación:</label>
                                <input type="text" id="eventLocation" name="eventLocation" required><br><br>

                                <button type="submit">Agregar a mi Calendario</button>
                            </form>
                        </div>

                    </div>
                </div>


                <script>
                    document.getElementById('eventForm').addEventListener('submit', function (event) {
                        event.preventDefault(); // Prevent the form from submitting normally

                        // Get form values
                        const eventTitle = document.getElementById('eventTitle').value;
                        const eventDate = document.getElementById('eventDate').value;
                        const eventStartTime = document.getElementById('eventStartTime').value;
                        const eventEndTime = document.getElementById('eventEndTime').value;
                        const eventDetails = document.getElementById('eventDetails').value;
                        const eventLocation = document.getElementById('eventLocation').value;

                        // Combine date and time to create the full datetime in UTC format
                        const startDateTime = new Date(`${eventDate}T${eventStartTime}:00Z`).toISOString();
                        const endDateTime = new Date(`${eventDate}T${eventEndTime}:00Z`).toISOString();

                        // Format the datetime in Google Calendar format: YYYYMMDDTHHMMSSZ
                        const startFormatted = startDateTime.replace(/[-:]/g, '').slice(0, 15) + 'Z';
                        const endFormatted = endDateTime.replace(/[-:]/g, '').slice(0, 15) + 'Z';

                        // Create the Google Calendar event URL
                        const calendarUrl = `https://www.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(eventTitle)}&dates=${startFormatted}/${endFormatted}&details=${encodeURIComponent(eventDetails)}&location=${encodeURIComponent(eventLocation)}&sf=true&output=xml`;

                        // Open the Google Calendar with pre-filled details
                        window.open(calendarUrl, '_blank');
                    });
                </script>



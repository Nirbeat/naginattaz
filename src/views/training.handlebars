            <script>
                // Function to reset and show all items
                function showAllItems() {
                    var items = document.querySelectorAll('.image-grid > div');
                    items.forEach(function (item) {
                        item.style.display = "block"; // Show all items
                    });

                    // Reset the instructor filter by removing any "active" class
                    var instructorButtons = document.querySelectorAll('.dropdown-item');
                    instructorButtons.forEach(function (button) {
                        button.classList.remove('active'); // Reset any "active" class (if used)
                    });

                    // Optionally, reset category filter (if any)
                    var categoryButtons = document.querySelectorAll('.dropdown-content button');
                    categoryButtons.forEach(function (button) {
                        button.classList.remove('active'); // Reset any "active" category
                    });

                    // Reset the dropdown visibility
                    var dropdowns = document.querySelectorAll('.dropdown-content');
                    dropdowns.forEach(function (dropdown) {
                        dropdown.style.display = 'none'; // Hide dropdowns again if needed
                    });
                }
                // Function to filter items by type (program or class)
                function filterItems(type, instructorId = '') {
                    var items = document.querySelectorAll('.image-grid > div');
                    items.forEach(function (item) {
                        let shouldDisplay = true;

                        // Check if the item matches the type (program or class)
                        if (type && !item.id.toLowerCase().includes(type)) {
                            shouldDisplay = false;
                        }

                        // Check if the item matches the instructor filter (if provided)
                        if (instructorId && !item.id.toLowerCase().includes(instructorId)) {
                            shouldDisplay = false;
                        }

                        // Show or hide based on filters
                        if (shouldDisplay) {
                            item.style.display = "block";
                        } else {
                            item.style.display = "none";
                        }
                    });
                }
                // Function to filter items by category (hiphop, contemporary, workout)
                function filterByCategory(category) {
                    var items = document.querySelectorAll('.image-grid > div');
                    items.forEach(function (item) {
                        // Check if the ID starts with the category name (e.g., 'hiphop', 'workout', etc.)
                        if (item.id.toLowerCase().startsWith(category)) {
                            item.style.display = "block"; // Show matching item
                        } else {
                            item.style.display = "none"; // Hide non-matching item
                        }
                    });
                }
                // Function to filter items by instructor name
                function filterByInstructor(instructorId) {
                    var items = document.querySelectorAll('.image-grid > div');
                    items.forEach(function (item) {
                        // Check if the ID contains the instructor's ID (e.g., 'vicky-branda')
                        if (item.id.toLowerCase().includes(instructorId)) {
                            item.style.display = "block"; // Show matching item
                        } else {
                            item.style.display = "none"; // Hide non-matching item
                        }
                    });
                }
                // Reset the "active" class on all instructor buttons when "Todas las Clases" is clicked
                {{!-- document.getElementById('show-all').addEventListener('click', function () {
                    showAllItems(); // Reset and show all items again
                }); --}}



            </script>


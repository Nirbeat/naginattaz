                        </div>
                        <script>
                            // Function to check if the lock is visible and disable interaction if it is
                            function disableInteractionsIfLocked() {
                                // Select all lock icons
                                const lockIcons = document.querySelectorAll('#lock-icon');

                                // Iterate over each lock icon
                                lockIcons.forEach(lockIcon => {
                                    // Use getComputedStyle to check visibility
                                    const lockVisible = window.getComputedStyle(lockIcon).display !== 'none';

                                    // Find the parent container of the lock icon
                                    const parentContainer = lockIcon.closest('div');

                                    if (parentContainer) {
                                        // Get the image inside this container
                                        const img = parentContainer.querySelector('.img-clases');

                                        if (lockVisible) {
                                            // If the lock icon is visible, blur the image and disable interaction
                                            if (img) {
                                                img.style.filter = 'blur(1px)';
                                                img.style.pointerEvents = 'none';
                                            }
                                        } else {
                                            // If the lock icon is not visible, remove blur and re-enable interaction
                                            if (img) {
                                                img.style.filter = 'none';
                                                img.style.pointerEvents = 'auto';
                                            }
                                        }
                                    }
                                });
                            }

                            // Ensure the script runs after the DOM content is fully loaded
                            document.addEventListener('DOMContentLoaded', () => {
                                disableInteractionsIfLocked();
                            });

                            // Add a MutationObserver to dynamically detect changes to the lock icon's visibility
                            const lockIcons = document.querySelectorAll('#lock-icon');
                            lockIcons.forEach(lockIcon => {
                                const observer = new MutationObserver(disableInteractionsIfLocked);
                                observer.observe(lockIcon, { attributes: true, attributeFilter: ['style', 'class'] });
                            });
                        </script>





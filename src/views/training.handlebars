        courses.forEach(course => {
            const courseLevel = course.querySelector(".course-level").textContent.toLowerCase();
            if (selectedLevel === "all" || courseLevel === selectedLevel) {
                course.style.display = "block";
            } else {
                course.style.display = "none";
            }
        });
    });
});

*/
</script>
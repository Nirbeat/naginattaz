{{>admin-menu}}

<div class="admin-card">
    <form>
        <label for="month">Mes</label>
        <select id="month">
            <option value="1">Enero</option>
            <option value="2">Febrero</option>
            <option value="3">Marzo</option>
            <option value="4">Abril</option>
            <option value="5">Mayo</option>
            <option value="6">Junio</option>
            <option value="7">Julio</option>
            <option value="8">Agosto</option>
            <option value="9">Septiembre</option>
            <option value="10">Octubre</option>
            <option value="11">Noviembre</option>
            <option value="12">Diciembre</option>
        </select>
        <label for="year">Año</label>
        <select id="year">
            <option value="2025">2025</option>
        </select>
        <button>Consultar</button>
    </form>
    <table>
        <tr>
            <td>Clase</td>
            <td>Vistas</td>
            <td>Profesor</td>
        </tr>
        {{#each classesData}}
        <tr>
            <td>{{this.class_name}}</td>
            <td>{{this.views}}</td>
            <td>{{this.teachers}}</td>
        </tr>
        {{/each}}
    </table>
</div>

{{!-- MANEJAR DINAMICAMENTE LA CONSULTA DE LOS MESES CON EL FORM --}}
<script>
    document.querySelector('form').addEventListener('submit', (e) => {
    })
</script>

<style>
body {
    color: #232323;
    font-family: 'Segoe UI', Arial, sans-serif;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
}

.admin-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 25px;
    background: #F3F3F3;
    padding: 32px;
    border-radius: 0;
    margin: 110px auto 40px auto;
    box-shadow: 0 2px 12px rgba(0,0,0,0.10);
    width: 90%;
    max-width: 900px;
    justify-content: center;
}

form {
    margin: 0;
    background: #FFFFFF;
    padding: 24px 32px;
    border-radius: 0;
    display: flex;
    align-items: center;
    gap: 18px;
    width: 100%;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
}

form label {
    margin-right: 6px;
    font-weight: 500;
    color: #232323;
}

form select {
    background: #fff;
    color: #232323;
    border: 1px solid #F3F3F3;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 15px;
    margin-right: 12px;
    outline: none;
    transition: border 0.2s;
}

form select:focus {
    border: 1.5px solid #BDBDBD;
}

form button {
    background: #BDBDBD;
    color: #232323;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
}

form button:hover {
    background: #232323;
    color: #fff;
}

table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: #FFFFFF;
    border-radius: 0;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
}

table tr:first-child {
    background: #BDBDBD;
}

table td {
    padding: 14px 18px;
    color: #232323;
    font-size: 15px;
    border-bottom: 1px solid #F3F3F3;
}

table tr:first-child td {
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    border-bottom: 2px solid #F3F3F3;
}

table tr:last-child td {
    border-bottom: none;
}

@media (max-width: 700px) {
    .admin-card {
        width: 98%;
        padding: 10px;
    }
    form {
        flex-direction: column;
        gap: 10px;
        width: 100%;
        padding: 14px 6px;
    }
    table {
        font-size: 14px;
    }
    table td {
        padding: 10px 8px;
    }
}
</style>


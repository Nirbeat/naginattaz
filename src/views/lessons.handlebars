<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clases</title>
    <link rel="stylesheet" href={{lessonsStyle}}>

</head>

<div class="nav-container">
    <nav>
        {{!-- Logo --}}
        <div class="logo_container">
            <a href="/">
                <img src="/images/main-logo.png" alt="NAGINATTAZ logo in black."
                    class="navbar10_logo icon-height-xlarge" />
            </a>
        </div>
        {{!-- Menu --}}
        <div class="nav_links">
            <a href="/">Inicio</a>
            <a href="/entrenamiento">Clases</a>
            <a href="/nagidatta">Nagidatta</a>
        </div>
        {{!-- Botonera --}}
        <div class="botonera">
            <div class="profile_pic">
                <img src={{profileImg}} alt="Profile picture">
            </div>
            <button type="button">Logout</button>
        </div>
        <div class="nav__hamburger">
            <button type="button" class="hamburger" onclick="toggleNav()">
                <span class="hamburger__line"></span>
                <span class="hamburger__line"></span>
                <span class="hamburger__line"></span>
            </button>
        </div>
    </nav>
</div>

<div class="main-section">

    <img class="main-img" id="mainImage" src="" alt="Main Image" style="display: none;">
    <iframe id="mainVideo" class="main-video" style="display: block;" frameborder="0"
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write" src="https://player.vimeo.com/video/{{currentLesson}}" title="Main Vimeo Video"></iframe>

</div>


<div class="info-carousel-section">
    <div class="video-info">
        <div class="video-title">{{courseName}}</div>
        <br>
        <div class="descripcion">
            <h3>Programa:</h3>
            {{#each lessons}}
            <a href="/clases/{{this.class_id}}/{{this.id}}">
                <li>
                    {{this.name}}
                    <br>
                </li>
            </a>
            {{/each}}

        </div>
    </div>
</div>

<script>
    function toggleNav() {
        const navLinks = document.querySelector('.nav_links');
        navLinks.classList.toggle('active');
    }
</script>
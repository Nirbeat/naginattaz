<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clases</title>
    <link rel="stylesheet" href={{lessonsStyle}}>

</head>

    {{>trainingNav}}


<div class="main-section">

    <img class="main-img" id="mainImage" src="" alt="Main Image" style="display: none;">
    <iframe id="mainVideo" class="main-video" style="display: block;" frameborder="0"
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
        src="https://player.vimeo.com/video/{{currentLesson.lesson_url}}" title="Main Vimeo Video"></iframe>

</div>


<div class="info-carousel-section">
    <div class="video-info">
        <div class="video-title">{{courseName}}
            <br>
            {{teacherName}}
        </div>
        <br>
        <div class="descripcion">
            <h3>Programa:</h3>
            {{#each fullLessons}}
            <a href="/clases/{{this.class_id}}/{{this.id}}">
                <li>
                    {{this.name}}
                    <br>
                </li>
            </a>
            {{/each}}

        </div>
    </div>
</div>

<script>
    function toggleNav() {
        const navLinks = document.querySelector('.nav_links');
        navLinks.classList.toggle('active');
    }
</script>
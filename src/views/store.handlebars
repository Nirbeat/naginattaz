<head>
    <link rel="stylesheet" href={{storeStyle}}>
    <script src="/scripts/index.temporary.js" defer></script>
</head>
<nav class="nav_index">
    <div class="nav__left">
        <div class="nav__logo">
            <a href="/">
                <img src="/images/main-logo.png" alt="NAGINATTAZ" height="150px" width="300px" />
            </a>
        </div>
        <div class="nav__links">
            <ul>
                <li>
                    <a href="/team">Team</a>
                </li>
                <li>
                    <a href="/entrenamiento">Entrenamiento</a>
                </li>
                <li>
                    <a href="/blog">Nagiblog</a>
                </li>
                <li class="active">
                    <a href="/store">Store
                        {{> cartIcon }}
                    </a>
                </li>
            </ul>
        </div>
    </div>
    <div class="nav__buttons">
        <button type="button" class="btn_secondary">
            <a href="/login">Inicia</a>
        </button>
        <button type="button" class="btn_primary">
            <a href="/subscribe">Sumate</a>
        </button>
    </div>
    <div class="nav__hamburger">
        <button type="button" class="hamburger">
            <span class="hamburger__line"></span>
            <span class="hamburger__line"></span>
            <span class="hamburger__line"></span>
        </button>
    </div>
</nav>
<section>
    <div class="slideshow-container">
        <div class="mySlides">
            <img src={{images.banners.web.store}}>
        </div>
    </div>
</section>
<section>
    <h2>Clases destacadas</h2>
    <div class="grid-auto-fill">
        {{#each courses}}
        <a href="/api/payment/{{this.id}}">
            <div class="course-container">
                <div class="course-card">
                    <h3>{{this.class_name}}</h3>
                    <p>{{this.class_level}}</p>
                    <p>${{this.class_price}}</p>
                    <img src={{this.class_image}} alt="">
                </div>
            </div>
        </a>
        {{/each}}
    </div>
</section>
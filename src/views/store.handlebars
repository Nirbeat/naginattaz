<head>
    <link rel="stylesheet" href={{storeStyle}}>
    <script src="/scripts/index.temporary.js" defer></script>
</head>

{{>main-nav}}

<section>
    <div class="slideshow-container">
        <div class="mySlides">
            <img src={{images.banners.web.store}}>
        </div>
    </div>
</section>
<section>
    <h2>Clases destacadas</h2>
    <div class="grid-auto-fill">
        {{#each courses}}
        <div class="course-container">
            <a href="/api/payment/{{this.id}}">
                <div class="course-card">
                    <div class="course-image">
                        <img src="{{#if this.class_image}}{{this.class_image}}{{else}}{{this.program_image}}{{/if}}"
                            alt="Imagen del curso">
                    </div>
                    <div class="course-info">
                        <h3 class="course-title">
                            {{#if this.class_name}}{{this.class_name}}{{else}}{{this.program_name}}{{/if}}
                        </h3>
                        <p class="course-level">{{this.class_level}}</p>
                        <p class="course-price">
                            ${{#if this.class_price}}{{this.class_price}}{{else}}{{this.program_price}}{{/if}}
                        </p>
                    </div>
                </div>
            </a>

        </div>
        {{/each}}
    </div>
</section>
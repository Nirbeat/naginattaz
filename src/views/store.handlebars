<head>
    <link rel="stylesheet" href="{{storeStyle}}">
    <script src="/scripts/index.temporary.js" defer></script>
</head>

{{>main-nav}}

<section>
    <div class="slideshow-container">
        <div class="mySlides">
            <img src="{{images.banners.store}}">
        </div>
    </div>
</section>
<section>
    <h2>Clases destacadas</h2>
    <div class="grid-auto-fill">
        {{#each courses}}
        <div class="course-container">
            <a href="/api/payment/{{this.id}}">
                <div class="course-card">
                    <div class="course-image">
                        <img src="{{#if this.class_image}}{{this.class_image}}{{else}}{{this.program_image}}{{/if}}"
                            alt="Imagen del curso">
                    </div>
                    <div class="course-info">
                        <h3 class="course-title">
                            {{#if this.class_name}}{{this.class_name}}{{else}}{{this.program_name}}{{/if}}
                        </h3>
                        <p class="course-level">{{this.class_level}}</p>
                        <p class="course-price" data-price="{{#if this.class_price}}{{this.class_price}}{{else}}{{this.program_price}}{{/if}}">
                        </p>
                        <p>{{#each this.teacherNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
                    </div>
                </div>
            </a>
        </div>
        {{/each}}
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".course-price").forEach(el => {
            let price = el.getAttribute("data-price");
            if (price !== null && price !== "") {
                let formattedPrice = Number(price).toLocaleString("es-ES", { minimumFractionDigits: 0 });
                console.log(`Price: ${price}, formatted: ${formattedPrice}`);
                el.textContent = `$${formattedPrice}`;
            } else {
                el.textContent = "$0";
            }
        });
    });
</script>


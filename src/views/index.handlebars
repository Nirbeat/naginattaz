<link rel="stylesheet" href={{indexStyle}}>
<script src="/scripts/index.temporary.js" defer></script>

{{>main-nav}}

<main>
    {{!-- Slideshow --}}
    <section>
        <div class="slideshow-container">
            <div class="fade mySlides">
                <img src={{images.banners.first}}>
            </div>
            <div class="fade mySlides">
                <img src={{images.banners.second}}>
            </div>
            <div class="dot-container">
                <span class="dot"></span>
                <span class="dot"></span>
            </div>
        </div>
    </section>

    {{!-- VIMEO --}}

    <section>
        <div class="video-section">
            <div class="video-container">
                <iframe src="https://player.vimeo.com/video/1067852286?badge=0&amp;autoplay=1&amp;muted=1&amp;player_id=0&amp;app_id=58479"
                    frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
                    title="nagi video">
                </iframe>
            </div>
            <div class="video-text">
                <header>
                    <div class="titles-container">
                        <h2>METAVERSO</h2>
                        <h1>STREET DANCE</h1>
                    </div>
                </header>
                <div class="text-container">
                    <p>Nuevas clases y desafíos cada mes</p>
                    <p>Profesores de primer nivel listos para inspirarte SIEMPRE</p>
                    <p>¡Descubrí nuestras clases y unite a nuestra comunidad!</p>
                </div>
                <a class="btn-primary">
                    Ver mas
                </a>
            </div>
        </div>
    </section>

    {{!-- Aprende Section --}}
    <section class="aprende-section">
        <header>
            <div class="aprende-content">
                <h3>Explora una variedad de clases diseñadas para un aprendizaje progresivo y motivador, con la mejor
                    guía.
                </h3>
                <div class="words">
                    <span>Aprende</span>
                    <span>Aplica</span>
                    <span>Avanza</span>
                    <span>Crece</span>
                    <span>Mejora</span>
                </div>
        </header>
        </div>
    </section>

    {{!-- Scrolling Text Section --}}
    <section>
        <div class="scrolling-text">
            <span>CONOCE NUESTRAS CLASES DISPONIBLES RECORDA QUE MES A MES SUMAMOS NUEVAS</span>
        </div>
    </section>

    {{!-- Tecnicas --}}
    <section>
        <div class="tecnicas-section">
            <header>
                <h4>Aprende una gran variedad de técnicas!</h4>
            </header>
            {{!-- Grid --}}
            <div class="grid-auto-fill">
                <a title="Hip Hop" class="grid-item">
                    <div class="card">
                        <div class="grid-img-container">
                            <img src="{{images.tecnicas.hiphop}}" loading="lazy" alt="Hip Hop">
                        </div>
                        <div class="grid-text">
                            <p>Hip Hop</p>
                        </div>
                    </div>
                </a>
                <a title="Dancehall" class="grid-item">
                    <div class="card">
                        <div class="grid-img-container">
                            <img src="{{images.tecnicas.dance_hall}}" loading="lazy" alt="Dancehall">
                        </div>
                        <div class="grid-text">
                            <p>Dancehall</p>
                        </div>
                    </div>
                </a>
                <a title="House Dance" class="grid-item">
                    <div class="card">
                        <div class="grid-img-container">
                            <img src="{{images.tecnicas.house_dance}}" loading="lazy" alt="House">
                        </div>
                        <div class="grid-text">
                            <p>House Dance</p>
                        </div>
                    </div>
                </a>
                <a title="Waacking" class="grid-item">
                    <div class="card">
                        <div class="grid-img-container">
                            <img src="{{images.tecnicas.waacking}}" loading="lazy" alt="Waacking">
                        </div>
                        <div class="grid-text">
                            <p>Waacking</p>
                        </div>
                    </div>
                </a>
                <a title="Heels" class="grid-item">
                    <div class="card">
                        <div class="grid-img-container">
                            <img src="{{images.tecnicas.heels}}" loading="lazy" alt="Heels">
                        </div>
                        <div class="grid-text">
                            <p>Heels</p>
                        </div>
                    </div>
                </a>
                <a title="Floorwork" class="grid-item">
                    <div class="card">
                        <div class="grid-img-container">
                            <img src="{{images.tecnicas.floorwork}}" loading="lazy" alt="Floorwork">
                        </div>
                        <div class="grid-text">
                            <p>Floorwork</p>
                        </div>
                    </div>
                </a>
                <a title="Herramientas de la danza contemporánea" class="grid-item">
                    <div class="card">
                        <div class="grid-img-container">
                            <img src="{{images.tecnicas.herramientas}}" loading="lazy"
                                alt="Herramientas de la danza contemporánea">
                        </div>
                        <div class="grid-text">
                            <p>Herramientas de la danza contemporánea</p>
                        </div>
                    </div>
                </a>
                <a title="Popping" class="grid-item">
                    <div class="card">
                        <div class="grid-img-container">
                            <img src="{{images.tecnicas.popping_soon}}" loading="lazy" alt="Popping">
                        </div>
                        <div class="grid-text">
                            <p>Popping (Coming Soon)</p>
                        </div>
                    </div>
                </a>
                <a title="Afro" class="grid-item">
                    <div class="card">
                        <div class="grid-img-container">
                            <img src="{{images.tecnicas.afro_soon}}" loading="lazy" alt="Afro">
                        </div>
                        <div class="grid-text">
                            <p>Afro (Coming Soon)</p>
                        </div>
                    </div>
                </a>
                <a title="Vogue" class="grid-item">
                    <div class="card">
                        <div class="grid-img-container">
                            <img src="{{images.tecnicas.vogue_soon}}" loading="lazy" alt="Vogue">
                        </div>
                        <div class="grid-text">
                            <p>Vogue (Coming Soon)</p>
                        </div>
                    </div>
                </a>
                <a title="Lite Feet" class="grid-item">
                    <div class="card">
                        <div class="grid-img-container">
                            <img src="{{images.tecnicas.lite_feet}}" loading="lazy" alt="Lite Feet">
                        </div>
                        <div class="grid-text">
                            <p>Lite Feet (Coming Soon)</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </section>
    <section>
        <div class="premium-section">
            <header>
                <h5>Sumate a la membresia</h5>
                <p>Subscribete y consigue tu Naginatta de diamante</p>
            </header>
            <div class="premium-card">
                <p class="subtitle">Full access</p>
                <h6>NAGINATTA DE DIAMANTE</h6>
                <div class="content">
                    <ul>
                        <li>Acceso ilimitado a todos los contenidos "on demand" de la platadorma</li>
                        <li>Clases en vivo exclusivas</li>
                        <li>Feedback personal para ajustar y mejorar tu progreso</li>
                        <li>Acceso a playlists personalizadas</li>
                        <li>Acceso a los mejores amigos de NGTZ en Instagram para recibir información de música,
                            noticias, educación y cultura de manera diaria</li>
                        <li>Acceso a toda la base de datos teórica y audiovisual (incluyendo recursos avanzados)</li>
                        <li>Envío del calendario de entrenamiento mensual</li>
                        <li>Acceso al canal de Telegram exclusivo</li>
                        <li>Miembros #comunidadngtz</li>
                    </ul>
                </div>
                <p><s>$50,000</s> <br> $39,000 <span>/mes</span></p>
                <a href="/api/payment/suscription" class="btn-primary">
                    Mejora tus habilidades
                </a>
            </div>
        </div>
    </section>
</main>
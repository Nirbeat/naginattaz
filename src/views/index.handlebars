<link rel="stylesheet" href={{indexStyle}}>
<script src="/scripts/index.temporary.js" defer></script>

{{>main-nav}}

<main>
    {{!-- Slideshow --}}
    <section>
        <div class="slideshow-container">
            <div class="fade mySlides">
                <img src={{images.banners.first}}>
            </div>
            <div class="fade mySlides">
                <img src={{images.banners.second}}>
            </div>
            <div class="dot-container">
                <span class="dot"></span>
                <span class="dot"></span>
            </div>
        </div>
    </section>

    {{!-- VIMEO --}}

    <section>
        <div class="video-section">
            <div class="video-container">
                <iframe src="https://player.vimeo.com/video/1067852286?badge=0&amp;autoplay=1&amp;muted=1&amp;player_id=0&amp;app_id=58479"
                    frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
                    title="nagi video">
                </iframe>
            </div>
            <div class="video-text">
                <header>
                    <div class="titles-container">
                        <h2>METAVERSO</h2>
                        <h1>STREET DANCE</h1>
                    </div>
                </header>
                <div class="text-container">
                    <p>Nuevas clases y desafíos cada mes</p>
                    <p>Profesores de primer nivel listos para inspirarte SIEMPRE</p>
                    <p>¡Descubrí nuestras clases y unite a nuestra comunidad!</p>
                </div>
                <a class="btn-primary">
                    Ver mas
                </a>
            </div>
        </div>
    </section>

    {{!-- Aprende Section --}}
    <section class="aprende-section">
        <header>
            <div class="aprende-content">
                <h3>Explora una variedad de clases diseñadas para un aprendizaje progresivo y motivador, con la mejor
                    guía.
                </h3>
                <div class="words">
                    <span>Aprende</span>
                    <span>Aplica</span>
                    <span>Avanza</span>
                    <span>Crece</span>
                    <span>Mejora</span>
                </div>
        </header>
        </div>
    </section>

    {{!-- Scrolling Text Section --}}
    <section>
        <div class="scrolling-text">
            <span>CONOCE NUESTRAS CLASES DISPONIBLES RECORDA QUE MES A MES SUMAMOS NUEVAS</span>
        </div>
    </section>
    {{>premium}}
</main>
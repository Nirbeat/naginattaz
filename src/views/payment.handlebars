<script src="https://sdk.mercadopago.com/js/v2">
</script>

<div id="wallet_container">
</div>
<script type="module">
    let publicKey= await fetch('http://localhost:3000/api/payment/public-key').then(data=> data.json())
    console.log(publicKey.MPPublicKey)
    const mp = new MercadoPago(publicKey.MPPublicKey, {
        locale: 'es-AR'
    });

    mp.bricks().create("wallet", "wallet_container", {
        initialization: {
            preferenceId: window.location.toString().split('/')[4]
        },
    });
</script>
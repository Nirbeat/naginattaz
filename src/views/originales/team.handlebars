    <div class="page-wrapper">
        
        <div data-animation="default" class="navbar10_component w-nav" data-easing2="ease"
            fs-scrolldisable-element="smart-nav" data-easing="ease" data-collapse="medium"
            data-w-id="22b31b6e-0227-378d-eaf5-deaab988bbcf" role="banner" data-duration="400">
            <div class="navbar10_container">
                <a href="/" aria-current="page" class="navbar10_logo-link w-nav-brand w--current">
                    <img src="/images/main-logo.png" alt="NAGINATTAZ logo in black."
                        class="navbar10_logo icon-height-xlarge" />
                </a>
            </div>
        </div>

        <nav role="navigation" class="navbar10_menu w-nav-menu">
            <div class="navbar10_menu-left">
                <a href="/tema"
                    class="navbar10_link text-size-tiny text-style-allcaps text-weight-semibold titlefont w-nav-link">TEAM</a>
                <a href="/clases"
                    class="navbar10_link text-size-tiny text-style-allcaps text-weight-semibold titlefont w-nav-link">ENTRENAMIENTO</a>
                <a href="/blog"
                    class="navbar10_link text-size-tiny text-style-allcaps text-weight-semibold titlefont  w-nav-link">BLOG</a>
                <a id="store" href="/store"
                    class="navbar10_link text-size-tiny text-style-allcaps text-weight-semibold titlefont w-nav-link">STORE
                    <img class="cart-button-image" src="/images/cart.png" alt="Carrito"
                        style="width:20px; border-radius: 0%; margin-left: 20px;">
                </a>
                

                <div data-hover="true" data-delay="300" data-w-id="22b31b6e-0227-378d-eaf5-deaab988bbdd"
                    class="navbar10_menu-dropdown w-dropdown">
                    <div
                        class="navbar10_dropdown-toggle text-size-tiny text-weight-semibold text-style-allcaps w-dropdown-toggle">
                    </div>
                </div>
            </div>
    </div>
    </nav>

    <main>
        <section class="team-section">
            <div class="team-heading">
                <h2>Nuestro Equipo!</h2>
            </div>


            <div class="team-grid">
                {{#each teamMembers}}

                <!-- Vicky Branda -->
                <div class="team-card">
                    <img src={{this.profile_image}}
                        alt={{this.name}}>
                    <div class="team-info">
                        <h3 class="team-name">{{this.name}}</h3>
                        <p class="team-role">{{this.skills}}</p>
                        <div class="team-social">
                            <a href={{this.instagramURL}} target="_blank">
                                <img src="/images/instagram-logo.svg" loading="lazy" alt=""
                                    class="social" />
                                <div class="footer-nav-link"></div>
                            </a>
                            <a href={{this.tiktokURL}} target="_blank" class="footer-social-link w-inline-block">
                                <img src="/images/tiktok-logo.svg" loading="lazy" alt=""
                                    class="social" />
                                <div class="footer-nav-link"></div>
                            </a>
                        </div>
                    </div>
                </div>
                {{/each}}

            </div>
        </section>
    </main>


    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

</html>